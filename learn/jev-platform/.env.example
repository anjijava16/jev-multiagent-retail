# ---- pick a chat provider: openai | anthropic
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=

# Models per role. Router + judge should be cheap, worker can be bigger.
OPENAI_WORKER_MODEL=gpt-4.1
OPENAI_ROUTER_MODEL=gpt-4.1-mini
OPENAI_JUDGE_MODEL=gpt-4.1-mini
ANTHROPIC_WORKER_MODEL=claude-sonnet-5-5
ANTHROPIC_ROUTER_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_JUDGE_MODEL=claude-haiku-4-5-20251001

# ---- embeddings (stay on OpenAI even with Claude as the chat model). "hash" = offline dev
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ---- vector store: opensearch | memory
VECTOR_BACKEND=opensearch
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=jev-knowledge
# OPENSEARCH_USER=admin
# OPENSEARCH_PASSWORD=...
# AWS OpenSearch Service with basic auth: OPENSEARCH_URL=https://search-xxx.us-east-1.es.amazonaws.com

# ---- JEV policy knobs
MAX_ATTEMPTS=3
ACCEPT_THRESHOLD=0.72
RISK_ESCALATION_THRESHOLD=0.8
ENABLE_JUDGE_ESCALATION=true
ROUTER_LLM_WEIGHT=0.7
